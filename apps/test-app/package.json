{
  "name": "test-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:check": "expo export --platform android --output-dir dist-ci --clear",
    "prebuild:check": "expo prebuild --no-install --clean"
  },
  "dependencies": {
    "@typegpu/noise": "0.12.0",
    "@typegpu/react": "0.12.0",
    "expo": "57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webgpu": "0.8.2",
    "react-native-worklets": "0.10.1",
    "typegpu": "0.12.1",
    "typegpu-confetti": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.10",
    "@webgpu/types": "^0.1.69",
    "expo-doctor": "^1.18.0",
    "typescript": "npm:tsover@6.0.2",
    "unplugin-typegpu": "0.12.2"
  },
  "packageManager": "pnpm@11.22.0",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "typescript"
      ]
    }
  },
  "worklets": {
    "staticFeatureFlags": {
      "BUNDLE_MODE_ENABLED": true
    }
  }
}
