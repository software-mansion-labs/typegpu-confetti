{
  "expo": {
    "name": "Confetti Test",
    "slug": "test-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EFEFF9"
        }
      ],
      "./plugins/with-ios-scene-lifecycle"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swmansion.typegpuconfetti.testapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFEFF9"
      },
      "package": "com.swmansion.typegpuconfetti.testapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
