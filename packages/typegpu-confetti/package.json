{
  "name": "typegpu-confetti",
  "version": "0.3.0",
  "description": "Customizable confetti animation component for React and React Native, running on the GPU",
  "keywords": [
    "confetti",
    "javascript",
    "react",
    "react-native",
    "webgpu"
  ],
  "bugs": {
    "url": "https://github.com/software-mansion-labs/typegpu-confetti/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-mansion-labs/typegpu-confetti.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react-native": "./src/react-native/index.ts",
    "./react": "./src/react/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.mjs"
      },
      "./react-native": {
        "types": "./dist/react-native/index.d.mts",
        "import": "./dist/react-native/index.mjs",
        "require": "./dist/react-native/index.cjs",
        "default": "./dist/react-native/index.mjs"
      },
      "./react": {
        "types": "./dist/react/index.d.mts",
        "import": "./dist/react/index.mjs",
        "require": "./dist/react/index.cjs",
        "default": "./dist/react/index.mjs"
      }
    },
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "build": "node prepack.mjs",
    "smoke": "node scripts/smoke-imports.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@typegpu/noise": "0.12.0"
  },
  "devDependencies": {
    "@typegpu/react": "0.12.0",
    "@types/react": "19.2.10",
    "@webgpu/types": "^0.1.69",
    "execa": "^9.6.0",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-webgpu": "0.8.2",
    "react-native-worklets": "0.10.1",
    "tsdown": "^0.22.14",
    "typescript": "npm:tsover@6.0.2",
    "unplugin-typegpu": "0.12.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@typegpu/react": ">=0.12.0 <0.13.0",
    "react": ">=19.2.0",
    "react-native": "*",
    "react-native-reanimated": ">=4.5.1",
    "react-native-webgpu": ">=0.8.2",
    "react-native-worklets": ">=0.10.1",
    "typegpu": ">=0.12.1 <0.13.0"
  },
  "peerDependenciesMeta": {
    "@typegpu/react": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-webgpu": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.22.0"
}
